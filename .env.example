# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aede

# ===========================================
# PLATFORM CONFIGURATIONS
# ===========================================

# X (Twitter) API
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret

# Bluesky (AT Protocol)
# Get app password at: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your_app_password

# Mastodon (Fediverse)
# Instance URL (e.g., https://mastodon.social)
MASTODON_INSTANCE=https://mastodon.social
# Create app at: https://your-instance/settings/applications
MASTODON_TOKEN=your_mastodon_access_token

# LinkedIn
# Get access token at: https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_ID=your_linkedin_person_id

# Threads (Meta)
# Get from Meta Developer Portal
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# Telegram Bot
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Webhook
# Create webhook in Discord channel settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/token
